# ============================================================================
# Site 100% estatico. Nada roda no servidor. Este arquivo tranca a pasta e
# repete os cabecalhos de seguranca (a mesma CSP das tags <meta>).
# Serve para Apache / LiteSpeed. Em hosts que ignoram .htaccess, so a <meta>
# CSP vale — replique os cabecalhos pelo mecanismo do provedor.
# ============================================================================

DirectoryIndex index.html

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
Options -Indexes

# ----------------------------------------------------------------------------
# Nunca executar nem servir codigo do lado do servidor
# ----------------------------------------------------------------------------
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phps|phar|pht|cgi|pl|py|rb|sh|lua|inc)$">
    Require all denied
</FilesMatch>

# Dotfiles (menos .well-known) e arquivos de fonte/backup
<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>
<FilesMatch "\.(bak|old|orig|save|swp|swo|dist|log|sql|md|map|yml|yaml|toml|lock)$">
    Require all denied
</FilesMatch>
<Files ".htaccess">
    Require all denied
</Files>

# ----------------------------------------------------------------------------
# Cabecalhos de seguranca
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Base 'none'. Só o proprio dominio ('self'). 'manifest-src self' existe
    # apenas para o app ser instalavel na tela de inicio. Nada sai do aparelho.
    Header always set Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; manifest-src 'self'"
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# ----------------------------------------------------------------------------
# Tipos e cache
# ----------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType text/html .html
    AddType text/javascript .js
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
    AddType text/css .css
    AddType application/manifest+json .webmanifest
    AddDefaultCharset UTF-8
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|svg|webmanifest)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    <FilesMatch "\.(woff2)$">
        Header set Cache-Control "public, max-age=604800, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>
